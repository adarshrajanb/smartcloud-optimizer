@import "tailwindcss";

:root {
  font-family: Inter, system-ui, sans-serif;
  background: #020617;
  color: #e2e8f0;
  line-height: 1.5;
  font-weight: 400;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  background: radial-gradient(circle at top, rgba(34, 211, 238, 0.18), transparent 25%),
    linear-gradient(180deg, #020617 0%, #0f172a 100%);
}

* {
  box-sizing: border-box;
}

body {
  min-height: 100vh;
}

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-thumb {
  background: #334155;
  border-radius: 9999px;
}
